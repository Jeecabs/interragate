# Scenario "mechanics", version 2 (the proposed change).

terraform {
  required_providers {
    random = { source = "hashicorp/random", version = "~> 3.6" }
    local  = { source = "hashicorp/local", version = "~> 2.5" }
    null   = { source = "hashicorp/null" }
  }
}

variable "environment" {
  description = "Deployment environment."
  type        = string
  default     = "production"
}

variable "zones" {
  description = "Zones to run one worker in each."
  type        = list(string)
  default     = ["a", "c"]
}

variable "db_password_seed" {
  type      = string
  default   = "seed-two"
  sensitive = true
}

locals {
  labels = {
    environment = var.environment
    cluster     = random_pet.cluster.id
  }
}

resource "random_pet" "cluster" {
  length = 2
}

resource "random_id" "suffix" {
  byte_length = 4
  keepers = {
    environment = var.environment
  }
}

resource "random_password" "db" {
  length  = 24
  special = false
  keepers = {
    seed = var.db_password_seed
  }
}

# Renamed from random_string.api_key without a moved block.
resource "random_string" "api_token" {
  length  = 32
  special = false
}

moved {
  from = random_string.session_secret
  to   = random_string.session_key
}

resource "random_string" "session_key" {
  length  = 16
  special = false
}

import {
  to = random_string.imported
  id = "Imported0Value1"
}

resource "random_string" "imported" {
  length  = 15
  special = false
}

resource "random_shuffle" "az" {
  input        = ["us-east-1a", "us-east-1b", "us-east-1c", "us-east-1d"]
  result_count = 2

  lifecycle {
    create_before_destroy = true
  }
}

resource "null_resource" "worker" {
  count = length(var.zones)

  triggers = {
    zone    = var.zones[count.index]
    cluster = random_pet.cluster.id
  }
}

resource "null_resource" "queue" {
  for_each = toset(["orders", "emails", "invoices"])

  triggers = {
    name = each.key
  }
}

resource "local_file" "policy" {
  filename = "${path.module}/out/policy.json"
  content = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid      = "ReadAssets"
        Effect   = "Allow"
        Action   = ["s3:GetObject"]
        Resource = ["arn:aws:s3:::assets-${random_id.suffix.hex}/*"]
      },
      {
        Sid      = "Debugging"
        Effect   = "Allow"
        Action   = ["s3:*"]
        Resource = ["*"]
      },
    ]
  })
}

data "local_file" "policy_read" {
  filename = local_file.policy.filename
}

resource "local_file" "config" {
  filename = "${path.module}/out/app.env"
  content  = <<-EOT
    CLUSTER=${random_pet.cluster.id}
    ENV=${var.environment}
    LOG_LEVEL=debug
    WORKERS=${length(var.zones)}
  EOT
}

resource "local_file" "readme" {
  filename = "${path.module}/out/README.md"
  content  = "Generated by Terraform. Do not edit.\n"
}

resource "terraform_data" "deploy" {
  input = {
    version = "1.5.0"
    labels  = local.labels
  }
}

resource "terraform_data" "migrations" {
  input = "schema-v7"

  lifecycle {
    replace_triggered_by = [terraform_data.deploy]
  }
}

resource "random_integer" "port" {
  min = 8000
  max = 8999
}

removed {
  from = random_uuid.legacy_id

  lifecycle {
    destroy = false
  }
}

check "port_in_range" {
  assert {
    condition     = random_integer.port.result >= 8000
    error_message = "Port must be at least 8000."
  }
}

module "cache" {
  source = "./modules/cache"
  name   = random_pet.cluster.id
}

output "cluster_name" {
  description = "Human-friendly cluster name."
  value       = random_pet.cluster.id
}

output "db_password" {
  value     = random_password.db.result
  sensitive = true
}

output "api_key" {
  value = random_string.api_token.result
}

output "queue_names" {
  value = sort(keys(null_resource.queue))
}
